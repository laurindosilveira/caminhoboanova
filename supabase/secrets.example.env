# Supabase Edge Function secrets for WhatsApp reminders.
# Copy these values into Supabase Dashboard > Edge Functions > Secrets
# or set them with `supabase secrets set --env-file supabase/secrets.env`.

SUPABASE_URL=https://hmmbspebnqkueqwcqinr.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider options: zapi, evolution, webhook.
WHATSAPP_PROVIDER=webhook
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE_ID=

# Public URL opened by reminder links.
APP_URL=https://app.caminhoboanova.com

# Web Push / VAPID.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Stripe Billing.
# Use a restricted live key in production when possible.
STRIPE_SECRET_KEY=
